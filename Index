(()=>{const sres=$("#sres"),qi=$("#qi");
 const norm=t=>t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/đ/g,"d");
 const item=p=>post(p.pin?pin("pin","Đã ghim"):"",p.c?av2(p.c,p.n[0].toUpperCase()):AV,nm(p.n,p.h,p.t,p.a?1:0)+(p.re?'<div class="tr" style="font-size:1rem">Đang trả lời <a href="#">@realdactrong</a></div>':"")+ptHtml(p.id,p.x),p.id);
 const run=()=>{const q=qi.value.trim();
  if(!q){sres.innerHTML='<div class="sh">Tìm kiếm bài đăng của @realdactrong</div>';return}
