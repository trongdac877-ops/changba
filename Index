  tw=av?Math.min(innerWidth*.88,innerHeight*.7,560):Math.min(innerWidth,840);
  lb.appendChild(g);el.classList.add("lb-hide");lb.classList.add("o");lb.setAttribute("aria-hidden","false");lock();
  void g.offsetWidth;g.style.transform=frame(innerWidth/2,innerHeight/2,tw)};
 const close=()=>{if(!g||busy)return;busy=1;cancelAnimationFrame(raf);raf=0;
  lb.classList.remove("drag");lb.classList.add("out");bg.style.transition="";bg.style.opacity="0";xb.style.opacity="";g.style.transform="none";
  setTimeout(()=>{g.remove();g=null;src.classList.remove("lb-hide");src=null;lb.classList.remove("o","out","drag");bg.style.cssText="";xb.style.opacity="";
   lb.setAttribute("aria-hidden","true");lock();busy=0},470)};
 const paint=()=>{raf=0;if(!g||busy)return;const p=Math.min(1,Math.abs(dy)/(innerHeight*.45));
  g.style.transform=frame(innerWidth/2+dx,innerHeight/2+dy,tw*(1-.35*p));bg.style.opacity=.96*(1-p);xb.style.opacity=1-Math.min(1,p*2)};
 track(lb,{
  start:e=>{if(!g||busy||e.target.closest(".lb-x"))return false;drag=0;dx=dy=0;onImg=!!e.target.closest(".lb-g")},
  move:(x,y)=>{if(busy)return false;dx=x;dy=y;if(!drag){if(Math.hypot(x,y)<6)return;drag=1;lb.classList.add("drag");bg.style.transition="none"}raf||(raf=requestAnimationFrame(paint))},
  end:(x,y,dt,c)=>{if(!g||busy)return;if(raf){cancelAnimationFrame(raf);paint()}
   if(!drag){!c&&!onImg&&close();return}
   if(!c&&(Math.abs(dy)>110||(Math.abs(dy)/dt>.6&&Math.abs(dy)>30)))close();
   else{lb.classList.remove("drag");bg.style.transition="";bg.style.opacity="";xb.style.opacity="";g.style.transform=frame(innerWidth/2,innerHeight/2,tw)}}});
 xb.onclick=close;addEventListener("resize",close);
 return{open,close,isOpen:()=>!!g}})();
