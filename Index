   dx=Math.min(0,x);raf||(raf=requestAnimationFrame(paint))},
  end:(x,y,dt,c)=>{if(lk!==1)return;if(raf){cancelAnimationFrame(raf);paint()}
   if(!c&&(dx<-Math.min(22,innerWidth*.06)||(-dx/dt>.12&&dx<-10))){
