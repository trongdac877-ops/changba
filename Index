 const P={passive:true};
 el.addEventListener("touchstart",e=>e.touches.length===1?d(e.touches[0].clientX,e.touches[0].clientY,e):u(e,1),P);
 el.addEventListener("touchmove",e=>{const t=e.touches[0];t&&m(t.clientX,t.clientY)},P);
 el.addEventListener("touchend",e=>u(e,0),P);el.addEventListener("touchcancel",e=>u(e,1),P);
 el.addEventListener("mousedown",e=>{e.button===0&&d(e.clientX,e.clientY,e)});
