/* chuông thông báo */
(()=>{const btn=$('[aria-label="Bật thông báo"]'),m=document.createElement("div");m.className="menu bm";m.setAttribute("role","menu");
 const CK='<svg class="i ck2" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>';
 const N=[["bell","Tất cả bài đăng","Nhận thông báo mỗi khi @realdactrong đăng bài mới"],["pin","Bài đăng nổi bật","Chỉ thông báo các bài quan trọng, như báo cáo tài chính"],["mute","Tắt thông báo","Không nhận thông báo từ tài khoản này"]];
 const T=["Đã bật thông báo cho tất cả bài đăng","Đã bật thông báo cho bài đăng nổi bật","Đã tắt thông báo"];let sel=2;
 m.innerHTML='<div class="bh">Thông báo từ @realdactrong</div>'+N.map(([i,t,d],k)=>`<button type="button" role="menuitemradio" data-k="${k}">${sv(i)}<div><b>${t}</b><small>${d}</small></div>${CK}</button>`).join("");
 document.body.appendChild(m);
 const paint=()=>{[...m.querySelectorAll("button")].forEach((b,k)=>{b.classList.toggle("sel",k===sel);b.setAttribute("aria-checked",k===sel)});
  btn.classList.toggle("bo",sel<2);btn.querySelector("use").setAttribute("href",sel<2?"#bell":"#bellp")};paint();
 const close=()=>m.classList.remove("o");
 btn.onclick=()=>{setMenu(0);if(m.classList.contains("o"))return close();const r=btn.getBoundingClientRect();m.style.top=r.bottom+8+"px";m.style.right=Math.max(8,innerWidth-r.right)+"px";m.classList.add("o")};
 m.onclick=e=>{const b=e.target.closest("button");if(!b)return;sel=+b.dataset.k;paint();close();toast(T[sel])};
 addEventListener("click",e=>{if(!m.contains(e.target)&&!e.target.closest('[aria-label="Bật thông báo"]'))close()},true);
 addEventListener("keydown",e=>{if(e.key==="Escape")close()},true);addEventListener("scroll",close,{passive:true})})();
</script>
