<script>
/* trang tóm tắt bài đăng (giả lập, không phải AI thật) */
(()=>{const pg=$("#v-grok"),gb=$("#gb"),q=$("#gq"),sd=$("#gs"),md=$("#gm"),mm=$("#gmm");
const IC={bolt:'<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',big:'<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',lite:'<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14zM5 19l7-7"/>'};
const ic=k=>`<svg class="i" viewBox="0 0 24 24">${IC[k]}</svg>`;
const MODES=[["Nhanh","bolt",1200],["Lớn nhất","big",2600],["Nhẹ nhất","lite",600]];
const H="@realdactrong",SEND='<svg class="i" viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>',STOP='<svg class="i" viewBox="0 0 24 24"><rect class="f" x="6" y="6" width="12" height="12" rx="2"/></svg>';
let mode=0,busy=0,tm=[],first=1;
const later=(f,ms)=>tm.push(setTimeout(f,ms)),clear=()=>{tm.forEach(clearTimeout);tm=[]};
const scroll=()=>gb.scrollTo({top:gb.scrollHeight,behavior:"smooth"});
const add=(h,c)=>{const d=document.createElement("div");d.className=c;d.innerHTML=h;gb.appendChild(d);scroll();return d};
const idl=()=>{gb.innerHTML=`<div class="gk-gid">${AV.replace("av","av")}<span>${H}</span></div>`};
const ui=()=>{sd.innerHTML=busy?STOP:SEND;sd.disabled=!busy&&!q.value.trim();sd.setAttribute("aria-label",busy?"Dừng":"Gửi");
 md.innerHTML=ic(MODES[mode][1])+MODES[mode][0];
 mm.innerHTML=MODES.map((m,k)=>`<button role="menuitemradio" data-k="${k}" class="${k===mode?"on":""}">${ic(m[1])}${m[0]}<svg class="i ck" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></button>`).join("")};
const RESULT=()=>{const n=SDB.filter(p=>p.h==="realdactrong").length;return `<div class="gk-gr"><h3>Tóm tắt các ý chính từ ${n} bài đăng của ${H}</h3><ul>
<li><b>calc</b>: chi phí máy móc về 0 vì người làm tự có thiết bị; chạy quy mô 20.000 khách hàng trong tháng, dự kiến khoảng 50.000 vào tháng 12/2026. Hiệu quả chuyển đổi sang tiền mặt được ước tính sẽ giảm mạnh, thuật toán sẽ được cắt xén để tập trung vào ngách hiệu quả, thu hồi vốn dưới 1 tháng.</li>
<li><b>roon</b>: mục tiêu 1.000 điểm bán, bỏ qua đăng ký giấy phép kinh doanh để đẩy nhanh, dự kiến hoàn thành gần hết vào tháng 2 năm sau rồi rà soát lại. Điểm mạnh được nêu là thu hồi vốn siêu nhanh và dễ đóng cửa hàng.</li>
<li><b>pol hold</b>: chính thức hoạt động từ 15/11, dùng chỉ số và dữ liệu thực về kho chứa và nguồn tiêu thụ, mua lại hàng cũ quy mô lớn, tích hợp mạnh với roon.</li>
<li><b>Báo cáo quý III (30/9)</b>: nhắc tới MAS, M5, xMAP, calc và xtest; một số mảng đang lỗ nặng; mục đích là minh bạch thông tin cho các bên.</li></ul>
<div class="gk-gn">Đây là bản tóm tắt tự động các ý chính từ bài đăng trên trang này, không phải lời khuyên đầu tư. Nguồn: <a href="https://changbaka.com/trong" target="_blank" rel="noopener noreferrer">changbaka.com/trong</a></div></div>`};
const think=t=>add(`<span class="sh">${t}</span>`,"gk-gt");
const summary=()=>{busy=1;ui();const th=think("Đang nghĩ");
 later(()=>th.firstChild.textContent="Đang tìm kiếm bài đăng của "+H+"…",500);
 later(()=>th.firstChild.textContent="Đang đọc các bài đăng…",1900);
 later(()=>th.firstChild.textContent="Đang tóm tắt các ý chính…",3400);
 later(()=>{th.remove();add(RESULT(),"gk-grw");busy=0;ui()},5000)};
const send=()=>{const v=q.value.trim();if(!v)return;if(busy)return;
 add(esc(v),"gk-gu");q.value="";q.style.height="";busy=1;ui();const th=think("Đang nghĩ");
 later(()=>{th.remove();add(`<div class="gk-gr">Nội dung này không liên quan tới các bài đăng của ${H}, nên chúng tôi không có dữ liệu để trả lời.</div>`,"gk-grw");busy=0;ui()},MODES[mode][2])};
const stop=()=>{clear();gb.querySelectorAll(".gk-gt").forEach(e=>e.remove());add("Đã dừng.","gk-gx");busy=0;ui()};
sd.onclick=()=>busy?stop():send();
q.addEventListener("input",()=>{q.style.height="auto";q.style.height=Math.min(q.scrollHeight,128)+"px";ui()});
q.addEventListener("keydown",e=>{if(e.key==="Enter"&&!e.shiftKey&&!e.isComposing){e.preventDefault();send()}});
