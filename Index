addEventListener("click",e=>{if(!mm.contains(e.target)&&e.target!==md)mm.classList.remove("o")});
$("#gnew").onclick=()=>{clear();busy=0;idl();ui();q.focus()};
$("#ghis").onclick=()=>toast("Chưa có lịch sử trò chuyện");
